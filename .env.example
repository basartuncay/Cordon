# Copy to .env and fill in. Never commit the real .env (see .gitignore).

# Required to run `make eval` against a real model.
ANTHROPIC_API_KEY=

# Model names — kept in config, not code (CLAUDE.md). All default to Haiku
# for now (cheap enough to pilot with); override independently as needed.
# cordon_runner currently binds one client to both the planner and
# quarantine roles by default (see CachingLLMClient note below) — separate
# planner_llm/quarantine_llm objects are supported but not yet the default.
CORDON_BASELINE_MODEL=claude-haiku-4-5-20251001
CORDON_PLANNER_MODEL=claude-haiku-4-5-20251001
CORDON_QUARANTINE_MODEL=claude-haiku-4-5-20251001

# Abort an eval run once input+output tokens across all scenarios exceeds
# this. --budget-usd is the primary spend guard in practice; this is a
# generous ceiling mainly meant to catch a runaway loop.
CORDON_TOKEN_BUDGET=700000

# Pricing used only to ESTIMATE run cost in the harness report/result file.
# These are placeholder Haiku-class $/MTok figures, NOT verified against a
# current pricing page. Check them against the actual price for
# CORDON_BASELINE_MODEL before trusting the estimate, then set
# CORDON_PRICING_VERIFIED=true — the harness prints an "unverified
# pricing" warning until you do.
CORDON_PRICE_INPUT_PER_MTOK_USD=1.0
CORDON_PRICE_OUTPUT_PER_MTOK_USD=5.0
CORDON_PRICING_VERIFIED=false

# Which ConfirmDecider cordon_runner (B3) uses when none is passed in:
# "deny" (default; upper bound in the defense's favor — nothing risky
# ever gets approved) or "approve" (blind rubber-stamp; worst case). Has
# no effect on B2 (the ablation never reaches a CONFIRM decision at all).
CORDON_CONFIRM_MODE=deny

# The harness caches every LLM response to disk under evals/.cache/
# (gitignored), keyed by model + the exact system/messages/tools sent.
# Cache hits never count toward tokens/cost and are reported separately —
# this is what lets B2 and B3 (and re-running the same scenario twice)
# share identical planner/quarantine calls for free. No env var to
# configure; it's always on for the harness.
