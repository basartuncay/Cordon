# Copy to .env and fill in. Never commit the real .env (see .gitignore).

# Required to run `make eval` against a real model.
ANTHROPIC_API_KEY=

# Model names — kept in config, not code (CLAUDE.md).
CORDON_BASELINE_MODEL=claude-sonnet-5
CORDON_PLANNER_MODEL=claude-sonnet-5
CORDON_QUARANTINE_MODEL=claude-haiku-4-5-20251001

# Abort an eval run once input+output tokens across all scenarios exceeds this.
CORDON_TOKEN_BUDGET=200000

# Pricing used only to ESTIMATE run cost in the harness report/result file.
# These are placeholder $/MTok figures, NOT verified against a current
# pricing page. Check them against the actual price for CORDON_BASELINE_MODEL
# before trusting the estimate, then set CORDON_PRICING_VERIFIED=true — the
# harness prints an "unverified pricing" warning until you do.
CORDON_PRICE_INPUT_PER_MTOK_USD=3.0
CORDON_PRICE_OUTPUT_PER_MTOK_USD=15.0
CORDON_PRICING_VERIFIED=false
